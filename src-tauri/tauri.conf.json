{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tesu Trader",
  "version": "1.1.0",
  "identifier": "com.tesu.trader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tesu Trader",
        "dataDirectory": "../local_data",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/engine/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://app.nitron.pro/tesu/releas/releases.json"
      ]
    }
  }
}
